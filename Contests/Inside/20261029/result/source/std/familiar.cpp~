#include<bits/stdc++.h>
#define LL long long
#define SZ(x) ((LL)(x.size()))
using namespace std;
long long read(){
  long long q=0,w=1;
  char ch=getchar();
  while(ch>'9' || ch<'0'){if(ch=='-')w=-1;ch=getchar();}
  while(ch>='0'&&ch<='9'){q=q*10+(ch-'0');ch=getchar();}
  return q*w;
}
void write(LL x){
  if(x<0){putchar('-');x=(-x);}
  if(x>9)write(x/10);
  putchar('0'+x%10);
}
void writeln(LL x){write(x);puts("");}
void writecs(LL x){write(x);putchar(' ');}
const long long N = 1e3+95;
long long n,m,T,a[N][N];
LL query(LL x,LL y,LL k){
  LL l1=0,r1=m-1,l2=0,r2=m-1;
  while(l1<=r1&&l2<=r2){
    LL m1=(l1+r1)>>1;
    LL m2=(l2+r2)>>1;
    LL cnt=(m1+m2);
    if(a[x][m1]<=a[y][m2]){
      if(cnt<k)l1=m1+1;
      else r2=m2-1;
    }
    else {
      if(cnt<k)l2=m2+1;
      else r1=m1-1;
    }
  }
  if(l1>r1){
    if(!l1)return a[y][k-1];
    else {
      LL u=a[x][l1-1],v=a[y][k-l1-1];
      return max(u,v);
    }
  }
  else {
    if(!l2)return a[x][k-1];
    else {
      LL u=a[y][l2-1],v=a[x][k-l2-1];
      return max(u,v);
    }
  }
}
void update(LL x,LL y){
  LL ans=-1;
  for(LL i=10;i>=0;i--)
    if(ans+(1<<i)<m&&a[x][ans+(1<<i)]<=y)ans+=(1<<i);
  if(ans==-1)return ;
  a[x][ans]=y;return ;
}
int main(){
  n=read();m=read();T=read();
  for(LL i=1;i<=n;i++)
    for(LL j=0;j<m;j++)a[i][j]=read();
  while(T--){
    LL opt=read();
    if(opt==1){
      LL x=read(),y=read(),k=read();
      k=(m*2-k+1);writeln(query(x,y,k));
    }
    else {
      LL x=read(),y=read();
      update(x,y);
    }
  }
  return 0;
}
